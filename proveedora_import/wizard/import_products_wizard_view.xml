<odoo>
    <record id="view_import_products_wizard_form" model="ir.ui.view">
        <field name="name">import.products.wizard.form</field>
        <field name="model">proveedora.import.products.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar productos y tarifas">
                <group>
                    <field name="file" filename="filename"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Importar" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_import_products_wizard" model="ir.actions.act_window">
        <field name="name">Importar productos y tarifas</field>
        <field name="res_model">proveedora.import.products.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_proveedora_import_wizard" name="Importar productos y tarifas" parent="menu_proveedora_import_root" action="action_import_products_wizard" sequence="1"/>
</odoo>

